{
 "dur": 75.84,
 "phrases": [
  {
   "t": "Cavas un pozo en tu patio para tener agua gratis.",
   "s": 0.07,
   "e": 2.8,
   "micro": 0
  },
  {
   "t": "Cavas…",
   "s": 3.36,
   "e": 4.15,
   "micro": 0
  },
  {
   "t": "y cavas…",
   "s": 4.51,
   "e": 5.49,
   "micro": 1
  },
  {
   "t": "y a los pocos metros, la tierra se derrumba y tapa el hoyo.",
   "s": 6.09,
   "e": 9.41,
   "micro": 1
  },
  {
   "t": "Así que metes un tubo de revestimiento, que sostiene las paredes.",
   "s": 9.99,
   "e": 13.43,
   "micro": 1
  },
  {
   "t": "Sigues bajando…",
   "s": 13.94,
   "e": 14.97,
   "micro": 0
  },
  {
   "t": "y nada.",
   "s": 15.42,
   "e": 15.9,
   "micro": 0
  },
  {
   "t": "Tierra seca.",
   "s": 16.41,
   "e": 17.23,
   "micro": 0
  },
  {
   "t": "Porque el agua no está en cualquier lado:",
   "s": 17.77,
   "e": 19.6,
   "micro": 0
  },
  {
   "t": "está más abajo,",
   "s": 20.05,
   "e": 21.1,
   "micro": 0
  },
  {
   "t": "donde la tierra y la roca están empapadas.",
   "s": 21.41,
   "e": 23.7,
   "micro": 0
  },
  {
   "t": "Se llama manto freático.",
   "s": 24.14,
   "e": 25.81,
   "micro": 0
  },
  {
   "t": "Por fin llegas…",
   "s": 26.33,
   "e": 27.33,
   "micro": 0
  },
  {
   "t": "y el agua sube un poquito.",
   "s": 27.64,
   "e": 29.09,
   "micro": 0
  },
  {
   "t": "Pero no hasta tu casa.",
   "s": 29.46,
   "e": 30.67,
   "micro": 0
  },
  {
   "t": "Entonces bajas una bomba sumergible, que la empuja hacia arriba por una tubería.",
   "s": 31.19,
   "e": 35.44,
   "micro": 1
  },
  {
   "t": "Abres la llave…",
   "s": 35.93,
   "e": 36.75,
   "micro": 0
  },
  {
   "t": "y sale turbia, llena de arena.",
   "s": 37.13,
   "e": 39.18,
   "micro": 2
  },
  {
   "t": "Así que pones grava y una rejilla al fondo, y un filtro antes de tu casa.",
   "s": 39.68,
   "e": 43.8,
   "micro": 2
  },
  {
   "t": "Ahora sale clara…",
   "s": 44.29,
   "e": 45.38,
   "micro": 0
  },
  {
   "t": "pero todavía te puede enfermar.",
   "s": 45.79,
   "e": 47.32,
   "micro": 0
  },
  {
   "t": "¿Por qué?",
   "s": 47.84,
   "e": 48.17,
   "micro": 0
  },
  {
   "t": "Tu fosa séptica está a pocos metros.",
   "s": 48.71,
   "e": 51.02,
   "micro": 2
  },
  {
   "t": "Lo que se filtra de ahí llega al mismo manto de donde sacas el agua.",
   "s": 51.4,
   "e": 54.89,
   "micro": 0
  },
  {
   "t": "Por eso el pozo va lejos:",
   "s": 55.37,
   "e": 56.92,
   "micro": 0
  },
  {
   "t": "en muchos lugares piden al menos quince metros…",
   "s": 57.25,
   "e": 59.76,
   "micro": 1
  },
  {
   "t": "y más en suelo arenoso.",
   "s": 60.06,
   "e": 61.33,
   "micro": 0
  },
  {
   "t": "Sellas la boca con concreto, para que no entre agua sucia de arriba.",
   "s": 61.89,
   "e": 65.46,
   "micro": 1
  },
  {
   "t": "Y mandas a analizar el agua antes de tomarla.",
   "s": 65.85,
   "e": 68.3,
   "micro": 1
  },
  {
   "t": "Y felicidades:",
   "s": 68.72,
   "e": 69.62,
   "micro": 0
  },
  {
   "t": "tienes agua de tu propio pozo.",
   "s": 69.94,
   "e": 71.76,
   "micro": 0
  },
  {
   "t": "¿Gratis?",
   "s": 72.25,
   "e": 72.78,
   "micro": 0
  },
  {
   "t": "Casi.",
   "s": 73.2,
   "e": 73.58,
   "micro": 0
  },
  {
   "t": "Ahora pagas la luz de la bomba.",
   "s": 74.02,
   "e": 75.62,
   "micro": 0
  }
 ],
