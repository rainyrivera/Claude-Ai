{
 "dur": 68.519,
 "phrases": [
  {
   "t": "Te llegó la factura alta y dijiste:",
   "s": 0.1,
   "e": 2.06,
   "micro": 0
  },
  {
   "t": "\"eso no se puede reclamar, no hacen nada\".",
   "s": 2.36,
   "e": 4.59,
   "micro": 1
  },
  {
   "t": "Pues mucha gente reclama…",
   "s": 5.19,
   "e": 6.69,
   "micro": 0
  },
  {
   "t": "y le devuelven el dinero.",
   "s": 7.08,
   "e": 8.36,
   "micro": 0
  },
  {
   "t": "El secreto está en hacerlo en orden.",
   "s": 8.83,
   "e": 10.89,
   "micro": 0
  },
  {
   "t": "Paso uno:",
   "s": 11.55,
   "e": 12.15,
   "micro": 0
  },
  {
   "t": "antes de reclamar,",
   "s": 12.65,
   "e": 13.54,
   "micro": 0
  },
  {
   "t": "revisa.",
   "s": 13.89,
   "e": 14.48,
   "micro": 0
  },
  {
   "t": "Compara cuántos kilovatios te cobraron con los meses anteriores,",
   "s": 14.99,
   "e": 18.22,
   "micro": 1
  },
  {
   "t": "y mira si el número del medidor coincide con el de la factura.",
   "s": 18.58,
   "e": 21.54,
   "micro": 0
  },
  {
   "t": "Paso dos:",
   "s": 22.19,
   "e": 22.86,
   "micro": 0
  },
  {
   "t": "reclama primero a la empresa.",
   "s": 23.24,
   "e": 24.89,
   "micro": 1
  },
  {
   "t": "Lleva tu identificación y tu número de contrato o de cliente.",
   "s": 25.31,
   "e": 28.56,
   "micro": 0
  },
  {
   "t": "Y lo más importante:",
   "s": 28.92,
   "e": 30.04,
   "micro": 0
  },
  {
   "t": "pide un número de reclamo o una constancia por escrito.",
   "s": 30.43,
   "e": 33.52,
   "micro": 0
  },
  {
   "t": "Sin papel,",
   "s": 33.92,
   "e": 34.52,
   "micro": 0
  },
  {
   "t": "no hay prueba.",
   "s": 34.83,
   "e": 35.54,
   "micro": 0
  },
  {
   "t": "Si esto te sirvió, suscríbete,",
   "s": 36.01,
   "e": 37.72,
   "micro": 1
  },
  {
   "t": "que aquí te explico lo que nadie te explica.",
   "s": 38.0,
   "e": 40.21,
   "micro": 0
  },
  {
   "t": "Paso tres:",
   "s": 40.84,
   "e": 41.51,
   "micro": 0
  },
  {
   "t": "si no te responden o la respuesta no te convence, no te quedes ahí.",
   "s": 41.93,
   "e": 46.02,
   "micro": 1
  },
  {
   "t": "Casi todos los países tienen una oficina del gobierno que protege al consumidor de luz, agua y teléfono.",
   "s": 46.42,
   "e": 52.31,
   "micro": 2
  },
  {
   "t": "Lleva la respuesta de la empresa o tu constancia de reclamo.",
   "s": 52.72,
   "e": 55.49,
   "micro": 0
  },
  {
   "t": "Paso cuatro:",
   "s": 56.17,
   "e": 56.84,
   "micro": 0
  },
  {
   "t": "no lo dejes para después.",
   "s": 57.3,
   "e": 58.91,
   "micro": 0
  },
  {
   "t": "Los reclamos tienen plazo,",
   "s": 59.31,
   "e": 60.65,
   "micro": 0
  },
  {
   "t": "y si se te pasa, pierdes el derecho.",
   "s": 61.01,
   "e": 63.02,
   "micro": 1
  },
  {
   "t": "Dime en los comentarios:",
   "s": 63.6,
   "e": 64.67,
   "micro": 0
  },
  {
   "t": "¿alguna vez reclamaste una factura?",
   "s": 65.05,
   "e": 66.72,
   "micro": 0
  },
  {
   "t": "¿Te resolvieron o no?",
   "s": 67.12,
   "e": 68.24,
   "micro": 0
  }
 ],
