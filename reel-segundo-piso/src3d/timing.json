{
 "dur": 101.52,
 "phrases": [
  {
   "t": "Dejaste las varillas en la azotea para el segundo piso…",
   "s": 0.04,
   "e": 2.83,
   "micro": 0
  },
  {
   "t": "pero",
   "s": 3.24,
   "e": 3.57,
   "micro": 0
  },
  {
   "t": "¿tu casa lo va a aguantar?",
   "s": 3.9,
   "e": 5.14,
   "micro": 0
  },
  {
   "t": "Subes los muros directo sobre la losa…",
   "s": 5.81,
   "e": 8.01,
   "micro": 1
  },
  {
   "t": "y a los meses, grietas en las paredes de abajo.",
   "s": 8.49,
   "e": 11.08,
   "micro": 1
  },
  {
   "t": "Porque todo el peso del segundo piso baja por los muros… hasta los cimientos.",
   "s": 11.55,
   "e": 16.17,
   "micro": 2
  },
  {
   "t": "Y si se hicieron para un solo piso,",
   "s": 16.56,
   "e": 18.33,
   "micro": 0
  },
  {
   "t": "se hunden.",
   "s": 18.59,
   "e": 19.21,
   "micro": 0
  },
  {
   "t": "Así que antes de poner un solo block,",
   "s": 19.7,
   "e": 21.96,
   "micro": 2
  },
  {
   "t": "un ingeniero revisa tus cimientos…",
   "s": 22.3,
   "e": 24.26,
   "micro": 0
  },
  {
   "t": "y si hace falta, los refuerza.",
   "s": 24.61,
   "e": 26.34,
   "micro": 1
  },
  {
   "t": "Ahora,",
   "s": 26.97,
   "e": 27.36,
   "micro": 0
  },
  {
   "t": "las varillas.",
   "s": 27.65,
   "e": 28.4,
   "micro": 0
  },
  {
   "t": "Llevan años al sol y a la lluvia…",
   "s": 28.79,
   "e": 30.88,
   "micro": 1
  },
  {
   "t": "y están oxidadas.",
   "s": 31.26,
   "e": 32.27,
   "micro": 0
  },
  {
   "t": "El óxido se come el acero.",
   "s": 32.78,
   "e": 34.51,
   "micro": 1
  },
  {
   "t": "Así que se revisan,",
   "s": 34.96,
   "e": 35.95,
   "micro": 0
  },
  {
   "t": "y si están muy dañadas, se refuerzan antes de seguir.",
   "s": 36.21,
   "e": 39.33,
   "micro": 2
  },
  {
   "t": "Levantas los muros…",
   "s": 39.99,
   "e": 41.12,
   "micro": 0
  },
  {
   "t": "pero sin castillos, en un temblor se abren como galleta.",
   "s": 41.45,
   "e": 44.68,
   "micro": 1
  },
  {
   "t": "Por eso cada muro va amarrado:",
   "s": 45.15,
   "e": 46.97,
   "micro": 1
  },
  {
   "t": "castillos de concreto en las esquinas, y una dala arriba.",
   "s": 47.43,
   "e": 50.46,
   "micro": 1
  },
  {
   "t": "Como un marco.",
   "s": 50.84,
   "e": 51.49,
   "micro": 1
  },
  {
   "t": "Y también alrededor de puertas y ventanas grandes, para que no se cuarteen de las esquinas.",
   "s": 51.92,
   "e": 56.85,
   "micro": 2
  },
  {
   "t": "Encima, la nueva losa, con su varilla bien puesta.",
   "s": 57.3,
   "e": 60.66,
   "micro": 2
  },
  {
   "t": "Pero antes de colar…",
   "s": 61.13,
   "e": 62.11,
   "micro": 0
  },
  {
   "t": "los tubos del agua, la luz y el drenaje del segundo piso tienen que bajar por algún lado.",
   "s": 62.49,
   "e": 67.44,
   "micro": 2
  },
  {
   "t": "Si no los dejas planeados, después toca romper.",
   "s": 67.94,
   "e": 71.07,
   "micro": 3
  },
  {
   "t": "Luego la escalera,",
   "s": 71.68,
   "e": 72.58,
   "micro": 0
  },
  {
   "t": "que mucha gente deja al final…",
   "s": 72.86,
   "e": 74.36,
   "micro": 0
  },
  {
   "t": "y termina tan empinada que da miedo subirla.",
   "s": 74.8,
   "e": 77.55,
   "micro": 1
  },
  {
   "t": "Y el tinaco sube un piso más,",
   "s": 78.03,
   "e": 79.95,
   "micro": 1
  },
  {
   "t": "porque el agua necesita altura para salir con presión.",
   "s": 80.33,
   "e": 83.07,
   "micro": 0
  },
  {
   "t": "Y el papel:",
   "s": 83.65,
   "e": 84.18,
   "micro": 0
  },
  {
   "t": "en muchos municipios necesitas licencia de construcción.",
   "s": 84.64,
   "e": 87.63,
   "micro": 0
  },
  {
   "t": "Sin ella, te pueden multar…",
   "s": 88.09,
   "e": 89.62,
   "micro": 1
  },
  {
   "t": "o parar la obra.",
   "s": 89.96,
   "e": 90.92,
   "micro": 0
  },
  {
   "t": "Y felicidades:",
   "s": 91.45,
   "e": 92.35,
   "micro": 0
  },
  {
   "t": "tu casa creció…",
   "s": 92.65,
   "e": 93.68,
   "micro": 0
  },
  {
   "t": "sin una sola cuarteadura.",
   "s": 94.01,
   "e": 95.71,
   "micro": 1
  },
  {
   "t": "¿Tú también tienes varillas esperando en la azotea?",
   "s": 96.28,
   "e": 98.48,
   "micro": 0
  },
  {
   "t": "Dime en los comentarios cuántos años llevan ahí.",
   "s": 98.96,
   "e": 101.26,
   "micro": 0
  }
 ],
