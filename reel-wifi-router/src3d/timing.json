{
 "dur": 98.16,
 "phrases": [
  {
   "t": "Tu internet va lento en el cuarto…",
   "s": 0.08,
   "e": 1.96,
   "micro": 0
  },
  {
   "t": "y ya vas a llamar a la compañía para pagar un plan más caro.",
   "s": 2.43,
   "e": 5.53,
   "micro": 0
  },
  {
   "t": "Espera.",
   "s": 6.1,
   "e": 6.44,
   "micro": 0
  },
  {
   "t": "Muchas veces el problema no es el plan.",
   "s": 7.01,
   "e": 9.32,
   "micro": 0
  },
  {
   "t": "Es dónde pusiste el router.",
   "s": 9.9,
   "e": 11.58,
   "micro": 0
  },
  {
   "t": "Te explico.",
   "s": 12.12,
   "e": 12.6,
   "micro": 0
  },
  {
   "t": "El router manda la señal de WiFi hacia todos los lados,",
   "s": 13.2,
   "e": 16.58,
   "micro": 2
  },
  {
   "t": "como cuando tiras una piedra en el agua y salen ondas.",
   "s": 16.85,
   "e": 19.43,
   "micro": 0
  },
  {
   "t": "Cada pared que esa señal atraviesa la debilita.",
   "s": 20.01,
   "e": 22.7,
   "micro": 0
  },
  {
   "t": "El metal y los espejos la rebotan,",
   "s": 23.2,
   "e": 25.19,
   "micro": 0
  },
  {
   "t": "y el agua, como la de una pecera, se la traga.",
   "s": 25.47,
   "e": 28.13,
   "micro": 3
  },
  {
   "t": "Y el microondas, cuando está prendido,",
   "s": 28.67,
   "e": 30.54,
   "micro": 1
  },
  {
   "t": "trabaja en la misma frecuencia que una de las bandas del WiFi y la interrumpe.",
   "s": 30.85,
   "e": 34.85,
   "micro": 0
  },
  {
   "t": "Por eso, si tu router está en una esquina, en el piso, detrás del televisor o dentro de un mueble,",
   "s": 35.42,
   "e": 41.08,
   "micro": 3
  },
  {
   "t": "gran parte de la señal se pierde antes de llegar a ti.",
   "s": 41.46,
   "e": 44.34,
   "micro": 1
  },
  {
   "t": "Paso uno:",
   "s": 45.13,
   "e": 45.7,
   "micro": 0
  },
  {
   "t": "llévalo al centro de la casa, o lo más cerca posible de donde más usas el internet.",
   "s": 46.17,
   "e": 50.96,
   "micro": 1
  },
  {
   "t": "Paso dos:",
   "s": 51.68,
   "e": 52.3,
   "micro": 0
  },
  {
   "t": "súbelo.",
   "s": 52.71,
   "e": 53.22,
   "micro": 0
  },
  {
   "t": "Ponlo en una repisa o encima de un mueble,",
   "s": 53.69,
   "e": 55.91,
   "micro": 0
  },
  {
   "t": "nunca en el piso.",
   "s": 56.18,
   "e": 57.2,
   "micro": 0
  },
  {
   "t": "Paso tres:",
   "s": 57.84,
   "e": 58.5,
   "micro": 0
  },
  {
   "t": "déjalo al aire libre.",
   "s": 58.89,
   "e": 60.17,
   "micro": 0
  },
  {
   "t": "Nada de gavetas ni muebles cerrados.",
   "s": 60.53,
   "e": 62.69,
   "micro": 2
  },
  {
   "t": "Paso cuatro:",
   "s": 63.29,
   "e": 63.94,
   "micro": 0
  },
  {
   "t": "aléjalo del microondas, de la nevera, de los espejos y de las cosas grandes de metal.",
   "s": 64.38,
   "e": 69.27,
   "micro": 2
  },
  {
   "t": "Paso cinco:",
   "s": 69.93,
   "e": 70.61,
   "micro": 0
  },
  {
   "t": "si tiene antenas, no las pongas todas iguales:",
   "s": 71.05,
   "e": 73.93,
   "micro": 2
  },
  {
   "t": "unas paradas y otras de lado.",
   "s": 74.26,
   "e": 75.93,
   "micro": 0
  },
  {
   "t": "Paso seis:",
   "s": 76.56,
   "e": 77.26,
   "micro": 0
  },
  {
   "t": "apágalo,",
   "s": 77.67,
   "e": 78.22,
   "micro": 0
  },
  {
   "t": "espera unos segundos y vuelve a prenderlo.",
   "s": 78.51,
   "e": 80.86,
   "micro": 1
  },
  {
   "t": "Y si tu casa es grande y aun así no llega,",
   "s": 81.53,
   "e": 84.16,
   "micro": 0
  },
  {
   "t": "ahí sí piensa en un repetidor o en un sistema de malla.",
   "s": 84.53,
   "e": 87.5,
   "micro": 0
  },
  {
   "t": "Pero primero prueba esto, que es gratis.",
   "s": 87.97,
   "e": 90.15,
   "micro": 2
  },
  {
   "t": "Mueve tu router hoy y haz la prueba en el cuarto donde no te llegaba.",
   "s": 90.59,
   "e": 94.24,
   "micro": 0
  },
  {
   "t": "¿Dónde tienes tu router ahora mismo?",
   "s": 94.79,
   "e": 96.38,
   "micro": 0
  },
  {
   "t": "Te leo en los comentarios.",
   "s": 96.86,
   "e": 97.96,
   "micro": 0
  }
 ],
