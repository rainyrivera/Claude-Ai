{
 "dur": 75.12,
 "phrases": [
  {
   "t": "Pones paneles solares en tu techo para no volver a pagar luz.",
   "s": 0.05,
   "e": 3.36,
   "micro": 0
  },
  {
   "t": "Los conectas directo a tu casa…",
   "s": 3.83,
   "e": 5.47,
   "micro": 0
  },
  {
   "t": "y nada.",
   "s": 5.93,
   "e": 6.5,
   "micro": 0
  },
  {
   "t": "Ni la tele prende.",
   "s": 6.91,
   "e": 7.94,
   "micro": 0
  },
  {
   "t": "Porque los paneles dan corriente directa…",
   "s": 8.44,
   "e": 10.45,
   "micro": 1
  },
  {
   "t": "y tu casa funciona con alterna.",
   "s": 10.76,
   "e": 12.36,
   "micro": 0
  },
  {
   "t": "Así que instalas un inversor, que la transforma.",
   "s": 12.82,
   "e": 15.39,
   "micro": 1
  },
  {
   "t": "Y ahora sí:",
   "s": 15.79,
   "e": 16.47,
   "micro": 0
  },
  {
   "t": "todo prende.",
   "s": 16.89,
   "e": 17.61,
   "micro": 0
  },
  {
   "t": "Pero llega la noche…",
   "s": 18.09,
   "e": 19.11,
   "micro": 0
  },
  {
   "t": "y otra vez a oscuras.",
   "s": 19.44,
   "e": 20.73,
   "micro": 0
  },
  {
   "t": "Entonces agregas baterías, para guardar lo que sobra del día.",
   "s": 21.15,
   "e": 24.37,
   "micro": 1
  },
  {
   "t": "Y entre los paneles y las baterías, un controlador de carga, para que no se sobrecarguen.",
   "s": 24.81,
   "e": 29.18,
   "micro": 2
  },
  {
   "t": "Pero al mediodía, con el sol más fuerte…",
   "s": 29.62,
   "e": 31.9,
   "micro": 1
  },
  {
   "t": "producen menos.",
   "s": 32.16,
   "e": 33.02,
   "micro": 0
  },
  {
   "t": "¿Por qué?",
   "s": 33.46,
   "e": 33.79,
   "micro": 0
  },
  {
   "t": "El calor.",
   "s": 34.24,
   "e": 34.86,
   "micro": 0
  },
  {
   "t": "Mientras más se calientan, menos energía dan.",
   "s": 35.27,
   "e": 37.76,
   "micro": 0
  },
  {
   "t": "Así que los separas del techo, para que les corra el aire por debajo.",
   "s": 38.26,
   "e": 41.37,
   "micro": 0
  },
  {
   "t": "Pero tu vecino siembra un árbol…",
   "s": 41.85,
   "e": 43.46,
   "micro": 0
  },
  {
   "t": "y una sola sombra en una esquina tumba la producción de todo el panel.",
   "s": 43.77,
   "e": 47.48,
   "micro": 2
  },
  {
   "t": "Por eso llevan diodos de derivación…",
   "s": 47.95,
   "e": 49.83,
   "micro": 0
  },
  {
   "t": "y tú los mueves donde nunca les dé sombra.",
   "s": 50.13,
   "e": 52.45,
   "micro": 0
  },
  {
   "t": "Y el ángulo importa:",
   "s": 52.83,
   "e": 53.85,
   "micro": 0
  },
  {
   "t": "la regla práctica es inclinarlos igual que la latitud de tu ciudad.",
   "s": 54.14,
   "e": 57.46,
   "micro": 0
  },
  {
   "t": "Ahora te sobra energía de día.",
   "s": 57.95,
   "e": 59.74,
   "micro": 0
  },
  {
   "t": "¿Qué haces con ella?",
   "s": 60.2,
   "e": 60.88,
   "micro": 0
  },
  {
   "t": "Pides un medidor bidireccional:",
   "s": 61.33,
   "e": 63.0,
   "micro": 0
  },
  {
   "t": "lo que sobra se va a la red…",
   "s": 63.36,
   "e": 64.71,
   "micro": 0
  },
  {
   "t": "y se descuenta de tu recibo.",
   "s": 64.97,
   "e": 66.4,
   "micro": 0
  },
  {
   "t": "Pones fusibles, conectas la tierra física…",
   "s": 66.81,
   "e": 69.2,
   "micro": 1
  },
  {
   "t": "Y felicidades:",
   "s": 69.51,
   "e": 70.41,
   "micro": 0
  },
  {
   "t": "tu casa fabrica su propia luz.",
   "s": 70.77,
   "e": 72.71,
   "micro": 0
  },
  {
   "t": "¿Y el recibo?",
   "s": 73.12,
   "e": 73.67,
   "micro": 0
  },
  {
   "t": "Casi en cero.",
   "s": 74.08,
   "e": 74.84,
   "micro": 0
  }
 ],
