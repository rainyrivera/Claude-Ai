{
 "dur": 95.76,
 "phrases": [
  {
   "t": "Tu recibo dice que gastaste esto…",
   "s": 0.09,
   "e": 2.2,
   "micro": 0
  },
  {
   "t": "pero tu contador puede decir otra cosa.",
   "s": 2.61,
   "e": 4.89,
   "micro": 1
  },
  {
   "t": "Y si no lo revisas, pagas lo que ellos digan.",
   "s": 5.42,
   "e": 8.18,
   "micro": 1
  },
  {
   "t": "Te explico.",
   "s": 8.74,
   "e": 9.22,
   "micro": 0
  },
  {
   "t": "El contador cuenta la luz que usas en kilovatios hora.",
   "s": 9.83,
   "e": 13.0,
   "micro": 1
  },
  {
   "t": "Cada mes alguien anota el número que marca, y la empresa le resta el número del mes anterior.",
   "s": 13.59,
   "e": 18.55,
   "micro": 1
  },
  {
   "t": "Esa resta es lo que te cobran.",
   "s": 19.1,
   "e": 20.85,
   "micro": 0
  },
  {
   "t": "Si anotan mal el número, o no vienen y lo calculan a ojo,",
   "s": 21.42,
   "e": 24.69,
   "micro": 2
  },
  {
   "t": "te puede llegar más de lo que gastaste.",
   "s": 25.09,
   "e": 27.03,
   "micro": 0
  },
  {
   "t": "Paso uno:",
   "s": 28.02,
   "e": 28.61,
   "micro": 0
  },
  {
   "t": "busca en tu factura la lectura anterior,",
   "s": 29.13,
   "e": 31.17,
   "micro": 1
  },
  {
   "t": "la lectura actual y los kilovatios cobrados.",
   "s": 31.44,
   "e": 33.97,
   "micro": 3
  },
  {
   "t": "Paso dos:",
   "s": 34.68,
   "e": 35.32,
   "micro": 0
  },
  {
   "t": "ve a tu contador sin tocarlo y tómale una foto al número,",
   "s": 35.78,
   "e": 39.14,
   "micro": 1
  },
  {
   "t": "con la fecha.",
   "s": 39.4,
   "e": 39.98,
   "micro": 0
  },
  {
   "t": "Paso tres:",
   "s": 40.72,
   "e": 41.4,
   "micro": 0
  },
  {
   "t": "compara.",
   "s": 41.84,
   "e": 42.36,
   "micro": 0
  },
  {
   "t": "Si tu contador marca menos que la lectura actual del recibo,",
   "s": 42.86,
   "e": 45.93,
   "micro": 1
  },
  {
   "t": "te cobraron consumo que todavía no has usado.",
   "s": 46.28,
   "e": 48.85,
   "micro": 0
  },
  {
   "t": "Paso cuatro:",
   "s": 49.59,
   "e": 50.28,
   "micro": 0
  },
  {
   "t": "mira si la factura dice que la lectura fue estimada.",
   "s": 50.8,
   "e": 53.57,
   "micro": 2
  },
  {
   "t": "Eso quiere decir que nadie leyó tu contador.",
   "s": 54.03,
   "e": 56.46,
   "micro": 0
  },
  {
   "t": "Paso cinco:",
   "s": 57.28,
   "e": 57.95,
   "micro": 0
  },
  {
   "t": "la prueba del vecino.",
   "s": 58.42,
   "e": 59.71,
   "micro": 1
  },
  {
   "t": "Apaga y desconecta todo en tu casa y mira el contador.",
   "s": 60.23,
   "e": 63.42,
   "micro": 3
  },
  {
   "t": "Si sigue corriendo, algo está gastando luz que tú no estás usando.",
   "s": 63.87,
   "e": 67.8,
   "micro": 2
  },
  {
   "t": "Puede ser un cable con problema o alguien conectado a tu línea.",
   "s": 68.31,
   "e": 71.45,
   "micro": 0
  },
  {
   "t": "Paso seis:",
   "s": 72.26,
   "e": 73.0,
   "micro": 0
  },
  {
   "t": "reclama primero en tu distribuidora, con las fotos.",
   "s": 73.46,
   "e": 76.29,
   "micro": 1
  },
  {
   "t": "Si no te resuelven, en República Dominicana puedes ir a Protecom,",
   "s": 76.71,
   "e": 80.33,
   "micro": 2
  },
  {
   "t": "que además tiene una calculadora oficial para revisar tu factura.",
   "s": 80.69,
   "e": 84.05,
   "micro": 0
  },
  {
   "t": "Ojo:",
   "s": 84.61,
   "e": 84.88,
   "micro": 0
  },
  {
   "t": "no abras ni toques el contador.",
   "s": 85.35,
   "e": 87.33,
   "micro": 1
  },
  {
   "t": "Si sigue corriendo con todo apagado,",
   "s": 87.83,
   "e": 89.73,
   "micro": 1
  },
  {
   "t": "que lo revise un electricista.",
   "s": 90.04,
   "e": 91.64,
   "micro": 0
  },
  {
   "t": "¿Ya revisaste tu contador este mes?",
   "s": 92.22,
   "e": 93.9,
   "micro": 0
  },
  {
   "t": "Te leo en los comentarios.",
   "s": 94.33,
   "e": 95.51,
   "micro": 0
  }
 ],
