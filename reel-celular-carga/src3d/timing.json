{
 "dur": 99.44,
 "phrases": [
  {
   "t": "Tu celular carga lento,",
   "s": 0.09,
   "e": 1.57,
   "micro": 0
  },
  {
   "t": "a veces carga y a veces no…",
   "s": 1.97,
   "e": 3.79,
   "micro": 0
  },
  {
   "t": "y ya estás pensando en comprar otra batería.",
   "s": 4.39,
   "e": 6.56,
   "micro": 0
  },
  {
   "t": "Espera.",
   "s": 7.06,
   "e": 7.43,
   "micro": 0
  },
  {
   "t": "Muchas veces no es la batería.",
   "s": 7.99,
   "e": 9.86,
   "micro": 0
  },
  {
   "t": "Mira dentro del puerto.",
   "s": 10.36,
   "e": 11.53,
   "micro": 0
  },
  {
   "t": "Te explico.",
   "s": 12.1,
   "e": 12.52,
   "micro": 0
  },
  {
   "t": "Cuando metes el cable, unos contactos metálicos del cable tienen que tocar los contactos del celular.",
   "s": 13.24,
   "e": 18.69,
   "micro": 2
  },
  {
   "t": "Pero cada vez que lo guardas en el bolsillo o en la cartera, entra pelusa.",
   "s": 19.37,
   "e": 23.43,
   "micro": 1
  },
  {
   "t": "Y cada vez que conectas el cable,",
   "s": 24.05,
   "e": 25.66,
   "micro": 0
  },
  {
   "t": "esa pelusa se empuja más al fondo y se aplasta como una alfombrita.",
   "s": 25.99,
   "e": 29.91,
   "micro": 0
  },
  {
   "t": "Con el tiempo,",
   "s": 30.59,
   "e": 31.28,
   "micro": 0
  },
  {
   "t": "el cable ya no entra completo,",
   "s": 31.59,
   "e": 33.19,
   "micro": 0
  },
  {
   "t": "los contactos no se tocan bien…",
   "s": 33.56,
   "e": 35.29,
   "micro": 0
  },
  {
   "t": "y el celular carga lento o se desconecta solo.",
   "s": 35.73,
   "e": 38.34,
   "micro": 0
  },
  {
   "t": "Paso uno:",
   "s": 39.23,
   "e": 39.79,
   "micro": 0
  },
  {
   "t": "apaga el celular.",
   "s": 40.29,
   "e": 41.28,
   "micro": 0
  },
  {
   "t": "Paso dos:",
   "s": 42.1,
   "e": 42.71,
   "micro": 0
  },
  {
   "t": "alumbra dentro del puerto con una linterna.",
   "s": 43.16,
   "e": 45.51,
   "micro": 0
  },
  {
   "t": "Si ves algo gris o negro pegado al fondo,",
   "s": 46.05,
   "e": 48.51,
   "micro": 0
  },
  {
   "t": "ahí está el problema.",
   "s": 48.78,
   "e": 49.88,
   "micro": 1
  },
  {
   "t": "Paso tres:",
   "s": 50.82,
   "e": 51.51,
   "micro": 0
  },
  {
   "t": "toma un palillo de dientes de madera.",
   "s": 52.03,
   "e": 53.81,
   "micro": 0
  },
  {
   "t": "Nunca uses aguja, clip ni nada de metal,",
   "s": 54.25,
   "e": 57.1,
   "micro": 1
  },
  {
   "t": "porque puedes rayar los contactos o hacer un corto.",
   "s": 57.48,
   "e": 60.04,
   "micro": 1
  },
  {
   "t": "Paso cuatro:",
   "s": 60.98,
   "e": 61.67,
   "micro": 0
  },
  {
   "t": "raspa suavecito, pegado a las paredes del fondo,",
   "s": 62.19,
   "e": 65.34,
   "micro": 3
  },
  {
   "t": "y saca la pelusa hacia afuera.",
   "s": 65.62,
   "e": 67.15,
   "micro": 0
  },
  {
   "t": "Sin fuerza y sin meter el palillo de golpe.",
   "s": 67.62,
   "e": 70.1,
   "micro": 1
  },
  {
   "t": "Paso cinco:",
   "s": 71.06,
   "e": 71.72,
   "micro": 0
  },
  {
   "t": "voltea el celular,",
   "s": 72.26,
   "e": 73.31,
   "micro": 0
  },
  {
   "t": "dale unos golpecitos suaves y vuelve a mirar con la linterna.",
   "s": 73.69,
   "e": 76.96,
   "micro": 2
  },
  {
   "t": "Paso seis:",
   "s": 77.92,
   "e": 78.65,
   "micro": 0
  },
  {
   "t": "limpia también la punta del cable con un paño seco.",
   "s": 79.13,
   "e": 81.89,
   "micro": 1
  },
  {
   "t": "Ahora conecta.",
   "s": 82.49,
   "e": 83.45,
   "micro": 2
  },
  {
   "t": "Si el cable entra completo y hace clic,",
   "s": 83.98,
   "e": 86.07,
   "micro": 0
  },
  {
   "t": "listo.",
   "s": 86.41,
   "e": 86.81,
   "micro": 0
  },
  {
   "t": "Si limpiaste y sigue igual,",
   "s": 87.4,
   "e": 88.93,
   "micro": 0
  },
  {
   "t": "prueba con otro cable y otro cargador.",
   "s": 89.36,
   "e": 91.39,
   "micro": 0
  },
  {
   "t": "Si con eso tampoco carga,",
   "s": 92.01,
   "e": 93.48,
   "micro": 0
  },
  {
   "t": "ahí sí llévalo a un técnico.",
   "s": 93.84,
   "e": 95.48,
   "micro": 1
  },
  {
   "t": "¿Cuánta pelusa le salió al tuyo?",
   "s": 96.17,
   "e": 97.59,
   "micro": 0
  },
  {
   "t": "Te leo en los comentarios.",
   "s": 98.07,
   "e": 99.18,
   "micro": 0
  }
 ],
