{
 "dur": 98.4,
 "phrases": [
  {
   "t": "Si conectas los cables en el orden equivocado para pasarle corriente a tu carro, puedes dañarlo…",
   "s": 0.03,
   "e": 5.22,
   "micro": 1
  },
  {
   "t": "o puede saltar una chispa justo al lado de la batería.",
   "s": 5.7,
   "e": 8.84,
   "micro": 1
  },
  {
   "t": "Te explico por qué.",
   "s": 9.32,
   "e": 10.13,
   "micro": 0
  },
  {
   "t": "Una batería descargada puede soltar un gas que se llama hidrógeno,",
   "s": 10.69,
   "e": 14.35,
   "micro": 0
  },
  {
   "t": "y ese gas se puede prender con una chispa.",
   "s": 14.75,
   "e": 17.14,
   "micro": 0
  },
  {
   "t": "Por eso el orden importa.",
   "s": 17.6,
   "e": 19.18,
   "micro": 1
  },
  {
   "t": "Paso uno:",
   "s": 20.18,
   "e": 20.74,
   "micro": 0
  },
  {
   "t": "apaga los dos carros y pon el freno de mano.",
   "s": 21.22,
   "e": 23.73,
   "micro": 0
  },
  {
   "t": "Revisa la batería:",
   "s": 24.33,
   "e": 25.32,
   "micro": 0
  },
  {
   "t": "si está rajada, hinchada o botando líquido, no le pases corriente.",
   "s": 25.75,
   "e": 29.99,
   "micro": 2
  },
  {
   "t": "Paso dos:",
   "s": 30.98,
   "e": 31.62,
   "micro": 0
  },
  {
   "t": "busca los signos.",
   "s": 32.02,
   "e": 33.08,
   "micro": 0
  },
  {
   "t": "El más es el positivo,",
   "s": 33.51,
   "e": 34.81,
   "micro": 0
  },
  {
   "t": "casi siempre con tapa roja.",
   "s": 35.17,
   "e": 36.63,
   "micro": 0
  },
  {
   "t": "El menos es el negativo.",
   "s": 37.08,
   "e": 38.56,
   "micro": 1
  },
  {
   "t": "Paso tres:",
   "s": 39.53,
   "e": 40.22,
   "micro": 0
  },
  {
   "t": "el cable rojo va primero al positivo de la batería muerta.",
   "s": 40.65,
   "e": 43.99,
   "micro": 1
  },
  {
   "t": "Paso cuatro:",
   "s": 44.89,
   "e": 45.59,
   "micro": 0
  },
  {
   "t": "la otra punta roja va al positivo de la batería buena.",
   "s": 46.06,
   "e": 49.11,
   "micro": 0
  },
  {
   "t": "Paso cinco:",
   "s": 50.06,
   "e": 50.78,
   "micro": 0
  },
  {
   "t": "el cable negro va al negativo de la batería buena.",
   "s": 51.21,
   "e": 54.09,
   "micro": 0
  },
  {
   "t": "Y aquí está el error que casi todo el mundo comete.",
   "s": 54.79,
   "e": 57.56,
   "micro": 2
  },
  {
   "t": "Paso seis:",
   "s": 58.17,
   "e": 58.9,
   "micro": 0
  },
  {
   "t": "la última punta negra NO va a la batería muerta.",
   "s": 59.3,
   "e": 62.45,
   "micro": 0
  },
  {
   "t": "Va a un metal sin pintura del carro descompuesto, como un tornillo del motor,",
   "s": 62.86,
   "e": 67.09,
   "micro": 1
  },
  {
   "t": "lejos de la batería.",
   "s": 67.45,
   "e": 68.62,
   "micro": 0
  },
  {
   "t": "Así, si salta una chispa, salta lejos del gas.",
   "s": 69.06,
   "e": 72.26,
   "micro": 2
  },
  {
   "t": "Paso siete:",
   "s": 73.21,
   "e": 73.88,
   "micro": 0
  },
  {
   "t": "prende el carro bueno y espera unos minutos.",
   "s": 74.36,
   "e": 76.77,
   "micro": 1
  },
  {
   "t": "Después prende el tuyo.",
   "s": 77.12,
   "e": 78.43,
   "micro": 1
  },
  {
   "t": "Paso ocho:",
   "s": 79.41,
   "e": 80.07,
   "micro": 0
  },
  {
   "t": "quita los cables al revés de como los pusiste.",
   "s": 80.47,
   "e": 82.85,
   "micro": 1
  },
  {
   "t": "Primero el negro del metal y último el rojo.",
   "s": 83.3,
   "e": 86.1,
   "micro": 2
  },
  {
   "t": "Rojo, rojo, negro, metal.",
   "s": 86.53,
   "e": 89.01,
   "micro": 4
  },
  {
   "t": "Apréndetelo.",
   "s": 89.49,
   "e": 90.09,
   "micro": 0
  },
  {
   "t": "Y si tu carro trae instrucciones distintas en el manual,",
   "s": 90.55,
   "e": 93.14,
   "micro": 0
  },
  {
   "t": "haz lo que diga el manual.",
   "s": 93.5,
   "e": 94.8,
   "micro": 0
  },
  {
   "t": "¿Tú lo hacías en este orden?",
   "s": 95.43,
   "e": 96.57,
   "micro": 0
  },
  {
   "t": "Te leo en los comentarios.",
   "s": 97.02,
   "e": 98.17,
   "micro": 0
  }
 ],
