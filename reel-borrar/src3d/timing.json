{
 "dur": 68.64,
 "phrases": [
  {
   "t": "Esa foto que borraste…",
   "s": 0.04,
   "e": 1.33,
   "micro": 0
  },
  {
   "t": "todavía puede estar ahí.",
   "s": 1.82,
   "e": 3.08,
   "micro": 0
  },
  {
   "t": "Y si vendes tu celular o tu computadora sin saber esto,",
   "s": 3.62,
   "e": 6.62,
   "micro": 0
  },
  {
   "t": "otra persona la podría recuperar.",
   "s": 6.92,
   "e": 8.69,
   "micro": 0
  },
  {
   "t": "Cuando borras algo, primero se va a la papelera.",
   "s": 9.29,
   "e": 11.94,
   "micro": 1
  },
  {
   "t": "En muchos celulares se queda ahí treinta días.",
   "s": 12.4,
   "e": 14.85,
   "micro": 1
  },
  {
   "t": "Hasta ese momento, es fácil de recuperar.",
   "s": 15.21,
   "e": 17.43,
   "micro": 1
  },
  {
   "t": "Pero aquí viene lo curioso:",
   "s": 17.93,
   "e": 19.43,
   "micro": 0
  },
  {
   "t": "aunque vacíes la papelera, muchas veces el archivo no se borra de verdad.",
   "s": 19.84,
   "e": 24.03,
   "micro": 1
  },
  {
   "t": "Imagina una biblioteca con un índice.",
   "s": 24.57,
   "e": 26.57,
   "micro": 0
  },
  {
   "t": "Lo que hace el sistema es borrar el libro del índice,",
   "s": 26.98,
   "e": 29.61,
   "micro": 0
  },
  {
   "t": "pero el libro sigue en el estante.",
   "s": 29.89,
   "e": 31.62,
   "micro": 0
  },
  {
   "t": "Ese espacio queda marcado como libre,",
   "s": 32.06,
   "e": 34.1,
   "micro": 0
  },
  {
   "t": "y el archivo sigue ahí hasta que algo nuevo se guarde encima.",
   "s": 34.53,
   "e": 37.82,
   "micro": 1
  },
  {
   "t": "Si te sorprendió, suscríbete, que aquí te explico cómo funcionan las cosas.",
   "s": 38.3,
   "e": 42.46,
   "micro": 4
  },
  {
   "t": "Por eso existen programas que recuperan archivos borrados.",
   "s": 42.89,
   "e": 45.9,
   "micro": 0
  },
  {
   "t": "Y si un día borras algo sin querer,",
   "s": 46.27,
   "e": 48.09,
   "micro": 0
  },
  {
   "t": "deja de usar ese aparato y busca ayuda rápido,",
   "s": 48.39,
   "e": 51.2,
   "micro": 0
  },
  {
   "t": "antes de que se guarde algo encima.",
   "s": 51.49,
   "e": 53.09,
   "micro": 1
  },
  {
   "t": "Y si vas a vender o regalar tu celular o tu computadora,",
   "s": 53.51,
   "e": 56.34,
   "micro": 0
  },
  {
   "t": "no basta con borrar las fotos.",
   "s": 56.63,
   "e": 58.37,
   "micro": 1
  },
  {
   "t": "Haz una copia de lo tuyo y después un restablecimiento de fábrica.",
   "s": 58.71,
   "e": 62.36,
   "micro": 2
  },
  {
   "t": "Dime en los comentarios:",
   "s": 62.84,
   "e": 63.92,
   "micro": 0
  },
  {
   "t": "¿alguna vez borraste algo sin querer que te dolió perder?",
   "s": 64.35,
   "e": 67.35,
   "micro": 0
  },
  {
   "t": "¿Qué era?",
   "s": 67.96,
   "e": 68.37,
   "micro": 0
  }
 ],
