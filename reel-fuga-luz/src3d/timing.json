{
 "dur": 101.6,
 "phrases": [
  {
   "t": "Oye,",
   "s": 0.05,
   "e": 0.36,
   "micro": 0
  },
  {
   "t": "haz esta prueba hoy:",
   "s": 0.65,
   "e": 1.64,
   "micro": 0
  },
  {
   "t": "apaga todo en tu casa y ve a ver tu medidor de luz.",
   "s": 2.15,
   "e": 5.18,
   "micro": 1
  },
  {
   "t": "Si sigue marcando, estás pagando luz que nadie está usando.",
   "s": 5.59,
   "e": 8.97,
   "micro": 1
  },
  {
   "t": "Mira,",
   "s": 9.57,
   "e": 9.82,
   "micro": 0
  },
  {
   "t": "la luz entra por el medidor,",
   "s": 10.13,
   "e": 11.65,
   "micro": 1
  },
  {
   "t": "pasa por la caja de los breakers…",
   "s": 11.95,
   "e": 13.55,
   "micro": 0
  },
  {
   "t": "y se va por cables escondidos dentro de tus paredes.",
   "s": 13.97,
   "e": 16.87,
   "micro": 1
  },
  {
   "t": "Y el medidor cuenta todo lo que pasa.",
   "s": 17.28,
   "e": 19.3,
   "micro": 1
  },
  {
   "t": "Lo uses tú…",
   "s": 19.69,
   "e": 20.34,
   "micro": 0
  },
  {
   "t": "o se pierda por ahí.",
   "s": 20.65,
   "e": 21.66,
   "micro": 0
  },
  {
   "t": "¿Y por dónde se pierde?",
   "s": 22.3,
   "e": 23.21,
   "micro": 0
  },
  {
   "t": "Por donde menos te imaginas.",
   "s": 23.62,
   "e": 25.38,
   "micro": 0
  },
  {
   "t": "Primero, los aparatos que nunca apagas de verdad:",
   "s": 25.91,
   "e": 28.47,
   "micro": 0
  },
  {
   "t": "la tele, el microondas, los cargadores.",
   "s": 28.98,
   "e": 31.49,
   "micro": 2
  },
  {
   "t": "Si tienen la lucecita prendida, siguen gastando.",
   "s": 31.9,
   "e": 34.57,
   "micro": 1
  },
  {
   "t": "Luego la nevera.",
   "s": 35.17,
   "e": 36.01,
   "micro": 0
  },
  {
   "t": "Si la goma de la puerta está rota, el frío se sale…",
   "s": 36.45,
   "e": 39.17,
   "micro": 1
  },
  {
   "t": "y el motor trabaja el doble.",
   "s": 39.53,
   "e": 40.94,
   "micro": 0
  },
  {
   "t": "Pero lo peligroso está dentro de la pared:",
   "s": 41.58,
   "e": 43.62,
   "micro": 0
  },
  {
   "t": "un cable pelado, mal unido o mojado.",
   "s": 44.18,
   "e": 46.51,
   "micro": 0
  },
  {
   "t": "La corriente se escapa a la tierra…",
   "s": 47.04,
   "e": 48.85,
   "micro": 0
  },
  {
   "t": "y tú la pagas.",
   "s": 49.23,
   "e": 50.41,
   "micro": 2
  },
  {
   "t": "Y ese cable también se calienta.",
   "s": 50.87,
   "e": 52.59,
   "micro": 0
  },
  {
   "t": "Por eso, si un enchufe está caliente o huele a quemado,",
   "s": 53.04,
   "e": 55.93,
   "micro": 0
  },
  {
   "t": "ojo,",
   "s": 56.32,
   "e": 56.62,
   "micro": 0
  },
  {
   "t": "eso es una alarma.",
   "s": 57.0,
   "e": 58.2,
   "micro": 1
  },
  {
   "t": "Ahora sí, la prueba:",
   "s": 58.77,
   "e": 59.91,
   "micro": 1
  },
  {
   "t": "desconecta todo y baja el breaker principal.",
   "s": 60.32,
   "e": 62.73,
   "micro": 3
  },
  {
   "t": "Mira el medidor unos minutos.",
   "s": 63.26,
   "e": 64.62,
   "micro": 1
  },
  {
   "t": "¿Se paró?",
   "s": 65.09,
   "e": 65.46,
   "micro": 0
  },
  {
   "t": "Sube el principal y prende los breakers uno por uno…",
   "s": 65.94,
   "e": 68.85,
   "micro": 1
  },
  {
   "t": "hasta que el medidor se vuelva a mover.",
   "s": 69.21,
   "e": 70.98,
   "micro": 0
  },
  {
   "t": "Ahí está tu fuga.",
   "s": 71.47,
   "e": 72.59,
   "micro": 0
  },
  {
   "t": "Y si con todo abajo el medidor sigue marcando…",
   "s": 73.1,
   "e": 75.64,
   "micro": 0
  },
  {
   "t": "el problema no es tu casa.",
   "s": 76.05,
   "e": 77.45,
   "micro": 0
  },
  {
   "t": "Puede ser el medidor.",
   "s": 77.8,
   "e": 78.79,
   "micro": 0
  },
  {
   "t": "Eso se reporta a la compañía de luz.",
   "s": 79.28,
   "e": 81.22,
   "micro": 0
  },
  {
   "t": "Eso sí:",
   "s": 81.67,
   "e": 82.11,
   "micro": 0
  },
  {
   "t": "no abras el medidor ni toques los cables.",
   "s": 82.44,
   "e": 84.96,
   "micro": 1
  },
  {
   "t": "Para eso llamas a un electricista.",
   "s": 85.32,
   "e": 87.05,
   "micro": 0
  },
  {
   "t": "Él cambia el cable malo, aprieta las uniones…",
   "s": 87.45,
   "e": 90.05,
   "micro": 1
  },
  {
   "t": "y pone un breaker especial que corta la luz si detecta una fuga.",
   "s": 90.34,
   "e": 93.81,
   "micro": 1
  },
  {
   "t": "Y listo:",
   "s": 94.25,
   "e": 94.69,
   "micro": 0
  },
  {
   "t": "tu medidor ya solo cuenta lo que tú usas.",
   "s": 95.05,
   "e": 97.59,
   "micro": 1
  },
  {
   "t": "¿Cuánto te llegó de luz el último mes?",
   "s": 98.15,
   "e": 99.86,
   "micro": 0
  },
  {
   "t": "Cuéntame en los comentarios.",
   "s": 100.25,
   "e": 101.36,
   "micro": 0
  }
 ],
