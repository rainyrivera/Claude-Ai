{
 "dur": 66.32,
 "phrases": [
  {
   "t": "Esa grieta en tu pared…",
   "s": 0.07,
   "e": 1.24,
   "micro": 0
  },
  {
   "t": "¿es solo pintura o es tu casa avisándote algo?",
   "s": 1.74,
   "e": 4.75,
   "micro": 1
  },
  {
   "t": "Hay una forma fácil de saberlo, y casi nadie la conoce.",
   "s": 5.43,
   "e": 8.76,
   "micro": 2
  },
  {
   "t": "Primero,",
   "s": 9.38,
   "e": 9.78,
   "micro": 0
  },
  {
   "t": "mira el ancho.",
   "s": 10.04,
   "e": 10.8,
   "micro": 1
  },
  {
   "t": "Si es finita como un pelo,",
   "s": 11.35,
   "e": 12.84,
   "micro": 0
  },
  {
   "t": "casi siempre es la pintura o el pañete.",
   "s": 13.18,
   "e": 15.37,
   "micro": 1
  },
  {
   "t": "Normalmente no es grave.",
   "s": 15.82,
   "e": 16.83,
   "micro": 0
  },
  {
   "t": "Segundo,",
   "s": 17.6,
   "e": 18.07,
   "micro": 0
  },
  {
   "t": "mira la dirección.",
   "s": 18.41,
   "e": 19.36,
   "micro": 0
  },
  {
   "t": "Las grietas en diagonal, o las que suben como una escalerita siguiendo los blocks, son las que preocupan.",
   "s": 19.93,
   "e": 25.23,
   "micro": 2
  },
  {
   "t": "Pueden ser señal de que algo en la estructura se está moviendo.",
   "s": 25.68,
   "e": 28.69,
   "micro": 0
  },
  {
   "t": "Y las horizontales suelen preocupar más que las verticales.",
   "s": 29.18,
   "e": 32.17,
   "micro": 0
  },
  {
   "t": "Si esto te sirvió, suscríbete, que aquí te enseño a entender tu casa.",
   "s": 32.63,
   "e": 36.46,
   "micro": 2
  },
  {
   "t": "Tercero,",
   "s": 37.12,
   "e": 37.5,
   "micro": 0
  },
  {
   "t": "mira si crece.",
   "s": 37.94,
   "e": 38.93,
   "micro": 0
  },
  {
   "t": "Marca con un lápiz las dos puntas de la grieta y escribe la fecha.",
   "s": 39.46,
   "e": 42.95,
   "micro": 1
  },
  {
   "t": "Si en unas semanas pasó la raya,",
   "s": 43.35,
   "e": 44.99,
   "micro": 0
  },
  {
   "t": "está creciendo.",
   "s": 45.26,
   "e": 46.11,
   "micro": 0
  },
  {
   "t": "Y ahora las alarmas:",
   "s": 46.71,
   "e": 48.03,
   "micro": 0
  },
  {
   "t": "una grieta de más de cinco milímetros,",
   "s": 48.42,
   "e": 50.56,
   "micro": 0
  },
  {
   "t": "una grieta que sigue creciendo,",
   "s": 50.86,
   "e": 52.54,
   "micro": 0
  },
  {
   "t": "o puertas que ya no cierran bien y pisos que se desnivelan.",
   "s": 52.83,
   "e": 56.08,
   "micro": 0
  },
  {
   "t": "Ahí no la tapes con pintura.",
   "s": 56.47,
   "e": 58.19,
   "micro": 0
  },
  {
   "t": "Llama a un ingeniero para que la revise.",
   "s": 58.51,
   "e": 60.52,
   "micro": 0
  },
  {
   "t": "Dime en los comentarios:",
   "s": 61.21,
   "e": 62.25,
   "micro": 0
  },
  {
   "t": "¿tienes alguna grieta en tu casa que te preocupe?",
   "s": 62.61,
   "e": 64.8,
   "micro": 0
  },
  {
   "t": "¿De qué forma es?",
   "s": 65.26,
   "e": 66.11,
   "micro": 0
  }
 ],
