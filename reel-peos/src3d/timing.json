{
 "dur": 46.32,
 "phrases": [
  {
   "t": "¿Por qué te tiras peos apestosos?",
   "s": 0.05,
   "e": 2.08,
   "micro": 2
  },
  {
   "t": "Mira a Luis.",
   "s": 2.48,
   "e": 3.14,
   "micro": 0
  },
  {
   "t": "Cada vez que se le sale uno en la oficina… se vacía el pasillo, mano.",
   "s": 3.65,
   "e": 7.71,
   "micro": 2
  },
  {
   "t": "Luis pensaba que estaba dañado por dentro.",
   "s": 8.37,
   "e": 10.3,
   "micro": 0
  },
  {
   "t": "Pero oye:",
   "s": 10.75,
   "e": 11.09,
   "micro": 0
  },
  {
   "t": "unos científicos le dieron habichuelas a dieciséis personas,",
   "s": 11.58,
   "e": 14.83,
   "micro": 0
  },
  {
   "t": "les recogieron los peos…",
   "s": 15.11,
   "e": 16.28,
   "micro": 0
  },
  {
   "t": "y pusieron a dos tipos a olerlos.",
   "s": 16.7,
   "e": 18.68,
   "micro": 0
  },
  {
   "t": "Ese trabajo no lo quiere nadie.",
   "s": 19.13,
   "e": 20.81,
   "micro": 0
  },
  {
   "t": "¿Y qué descubrieron?",
   "s": 21.49,
   "e": 22.27,
   "micro": 0
  },
  {
   "t": "Casi todo el gas no huele.",
   "s": 22.81,
   "e": 24.59,
   "micro": 1
  },
  {
   "t": "La peste es un chin de azufre que tus bacterias hacen con lo que comes.",
   "s": 25.19,
   "e": 28.83,
   "micro": 0
  },
  {
   "t": "Luis anotó lo que comía…",
   "s": 29.47,
   "e": 30.72,
   "micro": 0
  },
  {
   "t": "y ¡pum!",
   "s": 31.07,
   "e": 31.73,
   "micro": 1
  },
  {
   "t": "Eran los huevos de cada mañana.",
   "s": 32.24,
   "e": 34.09,
   "micro": 1
  },
  {
   "t": "Los bajó…",
   "s": 34.59,
   "e": 35.12,
   "micro": 0
  },
  {
   "t": "y la oficina volvió a respirar.",
   "s": 35.59,
   "e": 37.34,
   "micro": 0
  },
  {
   "t": "Tú no estás dañado, loco.",
   "s": 37.94,
   "e": 39.33,
   "micro": 0
  },
  {
   "t": "Es tu plato.",
   "s": 39.63,
   "e": 40.36,
   "micro": 0
  },
  {
   "t": "Si te duele o cambia mucho,",
   "s": 40.9,
   "e": 42.34,
   "micro": 0
  },
  {
   "t": "pa'l médico.",
   "s": 42.6,
   "e": 43.16,
   "micro": 0
  },
  {
   "t": "Ahora dime…",
   "s": 43.76,
   "e": 44.2,
   "micro": 0
  },
  {
   "t": "¿quién es el Luis de tu casa?",
   "s": 44.7,
   "e": 46.05,
   "micro": 0
  }
 ],
